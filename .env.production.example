# ==============================================================================
# 🚀 Qarz Daftari (debtbook.uz) — Production Environment Variables
# Vercel Dashboard -> Settings -> Environment Variables bo'limiga kiritiladi
# ==============================================================================

# 1. Asosiy Ilova Sozlamalari
NEXT_PUBLIC_APP_URL=https://debtbook.uz
NEXT_PUBLIC_APP_NAME="Qarz Daftari"
NODE_ENV=production

# 2. Supabase Ma'lumotlar Bazasi (Production Database)
# Supabase Dashboard -> Project Settings -> API bo'limidan olinadi
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOi...
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOi...

# 3. Avtomatlashtirilgan Cron Xavfsizlik Kaliti
# Vercel Cron chaqiruvlarini begonalardan himoya qilish uchun (ixtiyoriy, tavsiya etiladi)
CRON_SECRET=debtbook_cron_secret_secure_key_2026

# 4. Eskiz.uz SMS Integratsiyasi (Real SMS yuborish)
# eskiz.uz shaxsiy kabinetidagi hisob ma'lumotlari
ESKIZ_EMAIL=your-eskiz-email@gmail.com
ESKIZ_PASSWORD=your-eskiz-password
# Balans to'ldirilgach, jonli SMS yuborish uchun false qilinadi:
ESKIZ_TEST_MODE=false

# 5. CLICK To'lov Tizimi (https://merchant.click.uz)
# Webhook URL: https://debtbook.uz/api/payments/click/webhook
CLICK_MERCHANT_ID=61732
CLICK_SERVICE_ID=104455
CLICK_SECRET_KEY=your_click_secret_key
CLICK_MERCHANT_USER_ID=your_merchant_user_id

# 6. PAYME To'lov Tizimi (https://business.payme.uz)
# Webhook URL: https://debtbook.uz/api/payments/payme/webhook
PAYME_MERCHANT_ID=698082dc2b69c9940f33a385
PAYME_SECRET_KEY=your_payme_production_key
PAYME_TEST_KEY=your_payme_test_key

# 7. UZUM BANK To'lov Tizimi (https://business.uzumbank.uz)
# Webhook URL: https://debtbook.uz/api/payments/uzum/webhook
# Return URL:  https://debtbook.uz/dashboard?payment=success
UZUM_BASE_URL=https://api.uzumbank.uz
UZUM_TERMINAL_ID=your_uzum_terminal_id
UZUM_API_KEY=your_uzum_production_api_key
UZUM_RETURN_BASE_URL=https://debtbook.uz

# 8. TELEGRAM BOT & MINI APP (@debtbookuz_bot)
# Webhook URL: https://debtbook.uz/api/telegram/webhook
TELEGRAM_BOT_TOKEN=9064121371:AAEf9-454FMs_f1O5s7KTTVLPvdN81lcVSA
TELEGRAM_BOT_USERNAME=debtbookuz_bot
NEXT_PUBLIC_TELEGRAM_BOT_USERNAME=debtbookuz_bot
TELEGRAM_WEBHOOK_SECRET=debtbook_tg_secret_2026

